# Copy to .env. Never commit the real file.
# The service also reads ../backend/.env, so the keys may live there instead.

# Which provider answers: "gemini" or "openai". Leave empty to use Gemini when
# GEMINI_API_KEY is set, otherwise OpenAI.
AI_PROVIDER=

# Google Gemini (free tier) — https://aistudio.google.com/apikey
# Free-tier requests may be kept by Google and used to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: a different model for the conversational assistant.
GEMINI_ASSISTANT_MODEL=
GEMINI_TIMEOUT_SECONDS=40

# OpenAI (optional alternative) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: a different model for the conversational assistant.
OPENAI_ASSISTANT_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT_SECONDS=40

# Shared secret with the Express gateway (backend AI_SERVICE_TOKEN). When set,
# requests without it are refused. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
