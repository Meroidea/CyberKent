# Copy to .env. Never commit the real file.
# The service also reads ../backend/.env, so a key may live there instead.

# Which provider serves requests: auto | openai | gemini.
# On "auto" the service takes whichever key it finds, preferring OpenAI — so
# adding a Gemini key beside an existing OpenAI one never silently changes
# which model reads residents' messages. Name one to switch deliberately.
AI_PROVIDER=auto

# ── OpenAI — https://platform.openai.com/api-keys ────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: a different model for the conversational assistant.
OPENAI_ASSISTANT_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT_SECONDS=40

# ── Gemini — https://aistudio.google.com/apikey ──────────────────────────────
# Use a PAID key. On a free key, Google may use the prompts to improve their
# products; on a paid key they may not. Gemini has no per-request retention
# flag, so the billing tier is the whole of the control — see README.md.
# GOOGLE_API_KEY is read as well, because the Google SDK uses that name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: a different model for the conversational assistant.
GEMINI_ASSISTANT_MODEL=
GEMINI_TIMEOUT_SECONDS=40
# How much silent reasoning the model may do: minimal | low | medium | high,
# or blank for the model's own default. Not a cost dial — max_output_tokens
# covers thinking and the answer together, so raising this can truncate
# results. Raise it only after checking answers still come back.
GEMINI_THINKING_LEVEL=minimal

# ── Gateway ──────────────────────────────────────────────────────────────────
# Shared secret with the Express gateway (backend AI_SERVICE_TOKEN). When set,
# requests without it are refused. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
