# Copy to .env. Never commit the real file.
# The service also reads ../backend/.env, so OPENAI_API_KEY may live there instead.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: a different model for the conversational assistant.
OPENAI_ASSISTANT_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT_SECONDS=40

# Shared secret with the Express gateway (backend AI_SERVICE_TOKEN). When set,
# requests without it are refused. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
