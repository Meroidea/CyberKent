# Copy to .env. Never commit the real file.
# The service also reads ../backend/.env, so the keys may live there instead.

# Google Gemini (free tier) — https://aistudio.google.com/apikey
# Free-tier requests may be kept by Google and used to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: a different model for the conversational assistant.
GEMINI_ASSISTANT_MODEL=
# Tried once when the model above is overloaded or out of quota. Empty = off.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=40

# Shared secret with the Express gateway (backend AI_SERVICE_TOKEN). When set,
# requests without it are refused. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
