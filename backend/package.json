{
  "name": "cyberkent-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hume City Council CyberSafe Services — Online Scam Detection and Reporting System API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:showcase": "tsx prisma/seed-showcase.ts",
    "bundle": "node scripts/bundle.mjs",
    "vercel-build": "prisma generate && node scripts/bundle.mjs",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pg": "^8.20.4",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.1",
    "prisma": "^7.9.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
