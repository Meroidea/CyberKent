# Copy to .env and adjust for your environment. Never commit the real .env.
PORT=4000
NODE_ENV=development

# Secret used to sign JWT access tokens. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Where the SPA is served from (for CORS + verification links).
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection string. TLS is mandatory in production.
#
# `?schema=<name>` puts CyberKent's tables in their own schema, for a database
# shared with another application; both the API and `prisma migrate deploy`
# read it. The shared Supabase database uses the `cyberkent` schema and a
# `cyberkent_app` login that can reach nothing outside it:
#   postgresql://cyberkent_app.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require&schema=cyberkent
# Use the transaction pooler (port 6543) for the deployed API. The session
# pooler (5432) pins a server connection to each client and allows only 15, so
# a few serverless instances exhaust it; migrations may still use 5432.
# A dedicated database (Neon, local) can leave it off and use `public`:
DATABASE_URL=postgresql://USER:PASSWORD@HOST.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Connections each API instance may hold (1–20, default 3).
DATABASE_POOL_MAX=

# ── Transactional email (verification codes, password resets, receipts) ─────
# With no key, each email is printed to the API's console instead, and in
# development the verification code is also shown on screen. In production a
# missing key means nobody receives their codes — set it.
RESEND_API_KEY=
EMAIL_FROM=Hume CyberSafe <info@cyberkent.meroidea.com>
# Where links in emails point. Defaults to the first CLIENT_ORIGIN.
PUBLIC_APP_URL=

# Production only. Shared with the website's /api proxy (frontend/api/proxy.js);
# when set, the API answers nothing that did not come through the website.
# Leave blank locally.
API_PROXY_SECRET=

# Seed admin account, created by `npm run db:seed`. Change the password.
SEED_ADMIN_EMAIL=admin@cyberkent.local
SEED_ADMIN_PASSWORD=change-me-before-seeding
# Optional: `npm run db:seed:demo` makes officer.synthetic@cyberkent.test a
# sign-in-able officer with this password (12+ characters).
SEED_OFFICER_PASSWORD=

# ── AI Gateway → FastAPI AI service (ai-service/) ─────────────────────────────
# The AI service also loads this file. Every AI feature runs on Google Gemini
# (free tier key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried once when GEMINI_MODEL is overloaded or out of quota. Empty = off.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret; must match AI_SERVICE_TOKEN in ai-service/.env when set.
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=45000
AI_RATE_LIMIT=30

# ── Evidence storage (FR31–FR36) ─────────────────────────────────────────────
# Vercel Blob read-write token. Without it, production switches evidence
# uploads off (development stores files under backend/.storage instead).
BLOB_READ_WRITE_TOKEN=
# Optional: 32 random bytes, base64. Files are AES-256-GCM encrypted with it;
# when unset, a key is derived from JWT_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVIDENCE_ENCRYPTION_KEY=
