# Copy to .env and adjust for your environment. Never commit the real .env.
PORT=4000
NODE_ENV=development

# Secret used to sign JWT access tokens. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Where the SPA is served from (for CORS + verification links).
CLIENT_ORIGIN=http://localhost:5173

# Neon serverless Postgres. Get the connection string from the Neon dashboard
# or `neonctl connection-string --project-id <id>`. TLS is mandatory.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Transactional email (verification codes, password resets, receipts) ─────
# With no key, each email is printed to the API's console instead, and in
# development the verification code is also shown on screen. In production a
# missing key means nobody receives their codes — set it.
RESEND_API_KEY=
EMAIL_FROM=Hume CyberSafe <no-reply@your-verified-domain>
# Where links in emails point. Defaults to the first CLIENT_ORIGIN.
PUBLIC_APP_URL=

# Seed admin account, created by `npm run db:seed`. Change the password.
SEED_ADMIN_EMAIL=admin@cyberkent.local
SEED_ADMIN_PASSWORD=change-me-before-seeding
# Optional: `npm run db:seed:demo` makes officer.synthetic@cyberkent.test a
# sign-in-able officer with this password (12+ characters).
SEED_OFFICER_PASSWORD=

# ── AI Gateway → FastAPI AI service (ai-service/) ─────────────────────────────
# OPENAI_API_KEY is read by the AI service, which also loads this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret; must match AI_SERVICE_TOKEN in ai-service/.env when set.
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=45000
AI_RATE_LIMIT=30
