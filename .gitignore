# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Local caches
.vite/
.cache/

# Environment and secrets — never commit these.
.env
.env.local
.env.*.local

# Runtime data and uploads.
# Anchored, and named per service. Unanchored `data/` also matched
# `frontend/src/data/`, which is source the globe is built from — it was
# excluded from the commit and the deploy failed on the missing module.
/data/
/uploads/
backend/data/
backend/uploads/

# Model weights, fetched at build time by scripts/fetch-model.mjs.
# Tens of megabytes of binary that would otherwise live in every clone; the
# README beside them is the instructions and is kept.
frontend/public/models/*
!frontend/public/models/README.md

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
