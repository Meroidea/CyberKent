{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "backend"],
      "port": 4000
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && PORT=4100 CLIENT_ORIGIN=http://localhost:5174,http://localhost:5173 npx tsx watch src/server.ts"],
      "port": 4100
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && VITE_API_URL=http://localhost:4100 npx vite --port 5174 --strictPort"],
      "port": 5174
    },
    {
      "name": "ai-service",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd ai-service && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload"],
      "port": 8000
    }
  ]
}
