{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "backend"],
      "port": 4000
    },
    {
      "name": "ai-service",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd ai-service && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload"],
      "port": 8000
    }
  ]
}
